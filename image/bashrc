# The shell for OpenCode's terminal and any interactive bash, copied to /etc/bash.bashrc.
# Based on Omarchy's defaults. Tools from the tools option, such as eza and starship, are
# used when they're installed.

[ -z "${PS1-}" ] && return

. /etc/profile.d/mise.sh

shopt -s checkwinsize

# History, kept in $HOME across restarts
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"

# Command hashing would keep running a tool's old path after mise updates it
set +h

if [[ ! -v BASH_COMPLETION_VERSINFO && -f /usr/share/bash-completion/bash_completion ]]; then
  source /usr/share/bash-completion/bash_completion
fi

bind -f /etc/opencode-app/inputrc

# File system
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

if command -v bat &> /dev/null; then
  export BAT_THEME=ansi
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
fi

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

if command -v lazygit &> /dev/null; then
  alias lg='lazygit'
fi

if command -v zoxide &> /dev/null; then
  eval "$(zoxide init bash)"

  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi

      printf "\U000F17A9 "
      pwd
    fi
  }
fi

if command -v fzf &> /dev/null; then
  eval "$(fzf --bash)"
fi

if [[ ${TERM:-} != "dumb" ]] && command -v starship &> /dev/null; then
  eval "$(starship init bash)"
fi
