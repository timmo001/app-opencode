#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant OpenCode Add-on
# Take down the S6 supervision tree when OpenCode fails
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "OpenCode crashed, halting add-on"
  /run/s6/basedir/bin/halt
fi

bashio::log.info "OpenCode stopped, restarting..."
